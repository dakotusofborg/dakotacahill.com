---
import Base from '@/layouts/Base.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { site } from '@/data/site';
---

<Base title="About" description={`About ${site.name} and how to get in touch.`}>
  <section class="section">
    <div class="wrap cols">
      <div class="prose">
        <p class="hud-label">Player profile</p>
        <h1>About</h1>
        <p>
          <!-- Placeholder bio. Replace with your own. -->
          I'm {site.name}, a game developer working in C++ and Unreal Engine. I build games and the tools behind them,
          including an AI-assisted workflow built on Claude Code and custom MCP connectors.
        </p>
        <p>
          Here you'll find my <a href="/games/">games</a> (playable builds and source), my
          <a href="/blog/">devlog</a>, and my <a href="/cv/">CV</a>.
        </p>
      </div>

      <aside class="panel">
        <p class="hud-label">Open channel</p>
        <h2>Contact</h2>
        <p class="muted">For work, collaborations, or feedback on a build:</p>
        {
          site.email ? (
            <a class="btn" href={`mailto:${site.email}`}>
              Send a message
            </a>
          ) : (
            <p class="muted">
              <em>Add an email in src/data/site.ts</em>
            </p>
          )
        }
        <div class="links"><SocialLinks /></div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .cols {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .links {
    margin-top: 1.5rem;
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
