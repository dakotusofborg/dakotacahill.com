---
import Base from '@/layouts/Base.astro';
import { cv } from '@/data/cv';
import { site } from '@/data/site';
import { getGames, statusLabel } from '@/lib/content';

const games = (await getGames()).filter((g) => g.data.showOnCV);
const pretty = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const contact = [
  site.email && { label: site.email, href: `mailto:${site.email}` },
  site.links.linkedin && { label: pretty(site.links.linkedin), href: site.links.linkedin },
  site.links.github && { label: pretty(site.links.github), href: site.links.github },
].filter((c): c is { label: string; href: string } => Boolean(c));
---

<Base title="CV" description={`CV of ${site.name}, ${site.title}.`}>
  <section class="section">
    <div class="wrap cv">
      <header class="head">
        <div>
          <p class="hud-label no-print">Stats screen</p>
          <h1>{site.name}</h1>
          <p class="role">{cv.headline}</p>
          <p class="muted contact">
            <span>{cv.location}</span>
            {
              contact.map((c) => (
                <>
                  {' · '}
                  <a href={c.href}>{c.label}</a>
                </>
              ))
            }
          </p>
        </div>
        <button class="btn no-print" type="button" onclick="window.print()">Save as PDF</button>
      </header>

      <p class="summary">{cv.summary}</p>

      <div class="cols">
        <div>
          {
            games.length > 0 && (
              <>
                <h2>Game projects</h2>
                {games.map((g) => (
                  <div class="entry">
                    <div class="entry-head">
                      <h3>
                        <a href={`/games/${g.id}/`}>{g.data.title}</a>
                      </h3>
                      <span class="period">{statusLabel[g.data.status]}</span>
                    </div>
                    <p class="org muted">
                      {g.data.role} · {g.data.engine} {g.data.engineVersion} ·{' '}
                      {g.data.teamSize === 1 ? 'Solo' : `Team of ${g.data.teamSize}`}
                    </p>
                    <p>{g.data.description}</p>
                  </div>
                ))}
              </>
            )
          }

          <h2>Experience</h2>
          {
            cv.experience.map((job) => (
              <div class="entry">
                <div class="entry-head">
                  <h3>{job.role}</h3>
                  <span class="period">{job.period}</span>
                </div>
                <p class="org muted">
                  {job.org} · {job.location}
                </p>
                <ul>
                  {job.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            ))
          }

          <h3 class="sub">Earlier roles</h3>
          <ul class="earlier">
            {
              cv.earlier.map((e) => (
                <li>
                  <span>
                    <strong>{e.role}</strong>, {e.org}
                  </span>
                  <span class="period">{e.period}</span>
                </li>
              ))
            }
          </ul>

          <h2>Tools &amp; builds</h2>
          {
            cv.builds.map((b) => (
              <div class="entry">
                <h3>{b.name}</h3>
                <p class="org muted">{b.stack}</p>
                <ul>
                  {b.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <aside>
          <h2>Skills</h2>
          {
            cv.skills.map((s) => (
              <div class="skill">
                <p class="hud-label">{s.group}</p>
                <ul class="tags">
                  {s.items.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              </div>
            ))
          }

          <h2>Education</h2>
          {
            cv.education.map((e) => (
              <div class="entry">
                <h3>{e.title}</h3>
                <p class="org muted">
                  {e.org} · {e.period}
                </p>
              </div>
            ))
          }

          <h2>Certifications</h2>
          {
            cv.certifications.map((c) => (
              <div class="entry">
                <h3>{c.title}</h3>
                <p class="org muted">{c.period}</p>
              </div>
            ))
          }
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1.5rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
    padding-bottom: 1.5rem;
  }
  .role {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--accent);
    margin: 0;
  }
  .contact {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .summary {
    font-size: 1.15rem;
    max-width: 70ch;
    margin-block: 2rem;
  }
  .cols {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 3rem;
  }
  h2 {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-dim);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.4rem;
    margin-top: 2rem;
  }
  .entry {
    margin-bottom: 1.5rem;
    break-inside: avoid;
  }
  .entry-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }
  .entry h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .entry h3 a {
    color: inherit;
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    white-space: nowrap;
  }
  .org {
    margin: 0.1rem 0 0.4rem;
    font-size: 0.95rem;
  }
  .entry ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .sub {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    margin: 1.5rem 0 0.6rem;
  }
  .earlier {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    font-size: 0.95rem;
  }
  .earlier li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.3rem 0;
    border-bottom: 1px dashed var(--line);
  }
  .skill {
    margin-bottom: 1rem;
  }
  .skill .hud-label {
    margin-bottom: 0.4rem;
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }

  /* Clean, ink-friendly resume when saved as PDF */
  @page {
    margin: 0.5in;
  }
  @media print {
    /* rem-based spacing scales down with the root size */
    :global(html) {
      font-size: 9.5pt;
    }
    :global(body) {
      font-size: 9.5pt;
      line-height: 1.4;
    }
    .section,
    .wrap {
      padding: 0;
      max-width: none;
    }
    h1 {
      font-size: 22pt;
      margin-bottom: 0.1em;
    }
    .role {
      font-size: 11pt;
    }
    .head {
      padding-bottom: 0.6rem;
    }
    .summary {
      font-size: 10pt;
      max-width: none;
      margin-block: 0.8rem;
    }
    h2 {
      font-size: 9.5pt;
      margin-top: 0.9rem;
      margin-bottom: 0.4rem;
      break-after: avoid;
    }
    .sub {
      font-size: 9pt;
      margin-top: 0.6rem;
      break-after: avoid;
    }
    .entry {
      margin-bottom: 0.6rem;
    }
    .entry h3 {
      font-size: 10pt;
    }
    .org,
    .period,
    .contact {
      font-size: 8.5pt;
    }
    .entry ul {
      padding-left: 1rem;
    }
    .earlier {
      font-size: 9pt;
      margin-bottom: 0.6rem;
    }
    .earlier li {
      padding: 0.1rem 0;
    }
    .tags li {
      font-size: 7.5pt;
    }
    .skill {
      margin-bottom: 0.5rem;
    }
    h1,
    h2,
    h3,
    .role,
    .entry h3 a {
      color: #000;
    }
    .muted,
    .period,
    .org,
    .contact {
      color: #444;
    }
    h2,
    .head,
    .earlier li {
      border-color: #bbb;
    }
    .sub,
    .contact a {
      color: #000;
    }
    .tags li {
      background: none;
      color: #000;
      border-color: #bbb;
    }
    .skill .hud-label {
      color: #000;
    }
    .skill .hud-label::before {
      content: none;
    }
    .cols {
      grid-template-columns: 2.4fr 1fr;
      gap: 1.5rem;
    }
  }
</style>
