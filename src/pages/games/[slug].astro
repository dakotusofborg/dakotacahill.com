---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import DownloadCard from '@/components/DownloadCard.astro';
import PostList from '@/components/PostList.astro';
import { formatDate, getGames, getPosts, statusLabel, type Game } from '@/lib/content';

export const getStaticPaths = (async () => {
  const games = await getGames();
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}) satisfies GetStaticPaths;

const { game } = Astro.props as { game: Game };
const d = game.data;
const { Content } = await render(game);
const devlog = (await getPosts()).filter((p) => p.data.game?.id === game.id);
---

<Base title={d.title} description={d.description} image={d.cover}>
  <header class="hero">
    <Image src={d.cover} alt="" width={1600} class="hero-img" loading="eager" />
    <div class="hero-shade"></div>
    <div class="wrap hero-text">
      <p class="hud-label"><a href="/games/">Games</a> / {d.title}</p>
      <h1>{d.title}</h1>
      <p class="tagline">{d.tagline}</p>
      {
        d.credit && (
          <p class="credit">
            Built following the {d.credit.url ? <a href={d.credit.url}>{d.credit.name}</a> : d.credit.name} course.
          </p>
        )
      }
      <div class="chips">
        <span class="chip" data-status={d.status}>{statusLabel[d.status]}</span>
        {d.releaseDate && <span class="chip">{formatDate(d.releaseDate)}</span>}
      </div>
    </div>
  </header>

  <div class="wrap layout section">
    <div class="main">
      {
        d.trailer && (
          <div class="bracket video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${d.trailer}`}
              title={`${d.title} trailer`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        d.highlights.length > 0 && (
          <section>
            <p class="hud-label">What I built</p>
            <ul class="highlights">
              {d.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        d.clips.length > 0 && (
          <section>
            <p class="hud-label">Gameplay</p>
            <div class="media-grid">
              {d.clips.map((clip) => (
                <figure class="bracket">
                  <video src={clip.src} autoplay muted loop playsinline preload="metadata" />
                  {clip.caption && <figcaption>{clip.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )
      }

      {
        d.screenshots.length > 0 && (
          <section>
            <p class="hud-label">Screenshots</p>
            <div class="media-grid">
              {d.screenshots.map((shot) => (
                <a href={shot.src.src} class="bracket shot">
                  <Image src={shot.src} alt={shot.alt} width={800} />
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        devlog.length > 0 && (
          <section>
            <p class="hud-label">Devlog</p>
            <PostList posts={devlog} />
          </section>
        )
      }
    </div>

    <div class="side">
      <DownloadCard game={game} />

      <div class="panel">
        <p class="hud-label">Specs</p>
        <dl class="stats">
          <dt>Engine</dt>
          <dd>{d.engine}{d.engineVersion && ` ${d.engineVersion}`}</dd>
          <dt>Role</dt>
          <dd>{d.role}</dd>
          <dt>Team</dt>
          <dd>{d.teamSize === 1 ? 'Solo' : `${d.teamSize} people`}</dd>
          {
            d.duration && (
              <>
                <dt>Duration</dt>
                <dd>{d.duration}</dd>
              </>
            )
          }
          <dt>Platforms</dt>
          <dd>{d.platforms.join(', ')}</dd>
          {
            d.genres.length > 0 && (
              <>
                <dt>Genre</dt>
                <dd>{d.genres.join(', ')}</dd>
              </>
            )
          }
        </dl>
        {
          d.tech.length > 0 && (
            <>
              <p class="hud-label tech-label">Tech</p>
              <ul class="tags">
                {d.tech.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </div>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    min-height: clamp(320px, 55vh, 560px);
    display: flex;
    align-items: end;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    /* bottom + left fade so the title stays legible over busy key art */
    background:
      linear-gradient(to top, var(--bg) 5%, rgb(7 9 13 / 0.5) 55%, rgb(7 9 13 / 0.15)),
      linear-gradient(to right, rgb(7 9 13 / 0.7), transparent 65%);
  }
  .hero-text {
    position: relative;
    padding-bottom: 2.5rem;
  }
  .hero-text .hud-label a {
    color: inherit;
  }
  .tagline {
    font-size: 1.25rem;
    color: var(--text-dim);
    max-width: 50ch;
  }
  .credit {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin-top: -0.5rem;
  }
  .chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 3rem;
    align-items: start;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .side {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .video iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
  }
  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
  }
  .media-grid img,
  .media-grid video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  figure {
    margin: 0;
  }
  figcaption {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-top: 0.5rem;
  }
  .highlights {
    margin: 0;
    padding-left: 1.2rem;
  }
  .highlights li::marker {
    content: '■  ';
    color: var(--accent);
    font-size: 0.7em;
  }
  .tech-label {
    margin-top: 1.5rem;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      position: static;
      order: -1; /* download button above the fold on mobile */
    }
  }
</style>
