---
import { nav, site } from '@/data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="topbar no-print">
  <div class="wrap bar">
    <a href="/" class="logo">
      <span class="logo-mark" aria-hidden="true">DC</span>
      <span class="logo-text">{site.name}</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(7 9 13 / 0.88);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .logo-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: var(--accent);
    color: #041016;
    font-size: 0.9rem;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    display: block;
    padding: 0.5rem 0.85rem 0.5rem 1.35rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-dim);
  }
  /* menu-selection caret, like a game's main menu */
  nav a::before {
    content: '▶';
    position: absolute;
    left: 0.35rem;
    font-size: 0.6rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.12s, left 0.12s;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a:hover::before,
  nav a[aria-current='page']::before {
    opacity: 1;
    left: 0.5rem;
  }
  nav a[aria-current='page'] {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .logo-text {
      display: none;
    }
    nav a {
      padding: 0.4rem 0.5rem 0.4rem 1.1rem;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
    }
  }
</style>
