---
import { formatDate, type Post } from '@/lib/content';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ol class="log">
  {
    posts.map((post) => (
      <li>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <div>
          <a href={`/blog/${post.id}/`} class="title">
            {post.data.title}
            {post.data.draft && <span class="chip">Draft</span>}
          </a>
          <p class="muted">{post.data.description}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.25rem 1.25rem;
    padding: 1rem 0 1rem 1.5rem;
  }
  li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 1.45rem;
    width: 9px;
    height: 9px;
    background: var(--bg);
    border: 2px solid var(--accent);
    rotate: 45deg;
  }
  time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    padding-top: 0.2rem;
  }
  .title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
  }
  .title:hover {
    color: var(--accent);
  }
  p {
    margin: 0.2rem 0 0;
  }
  @media (max-width: 600px) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
