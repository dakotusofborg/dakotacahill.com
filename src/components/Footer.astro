---
import SocialLinks from '@/components/SocialLinks.astro';
import { site } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="no-print">
  <div class="wrap foot">
    <p class="muted">
      <span class="hud-label">End of level</span><br />
      © {year} {site.name}. Built with Astro.
      <a href="/rss.xml">RSS</a>
    </p>
    <SocialLinks />
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    background: var(--bg-2);
    margin-top: 4rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
    font-size: 0.9rem;
  }
  p {
    margin: 0;
  }
</style>
